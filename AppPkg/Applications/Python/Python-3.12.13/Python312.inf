[Protocols]
  gEfiCpuArchProtocolGuid
  gEfiLoadedImageProtocolGuid
  gEfiSimpleTextInputExProtocolGuid
  gEfiRngProtocolGuid
  gEfiShellProtocolGuid

[FixedPcd]
