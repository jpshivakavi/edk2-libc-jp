[Defines]
  INF_VERSION                 = 0x00010016
  BASE_NAME                   = Python312
  FILE_GUID                   = 1c13d89b-76e2-4dd1-8acd-d542b8009c4f
  MODULE_TYPE                 = UEFI_APPLICATION
  VERSION_STRING              = 0.1
  ENTRY_POINT                 = UefiMain

  DEFINE PYTHON_VERSION       = 3.12.13
  DEFINE LIBFFI_INC           = $(EDK2_LIBC_PATH)/AppPkg/Applications/Python/Python-3.12.13/PyMod-3.12.13/Modules/libffi/include
  DEFINE OPENSSL_ROOT       = $(EDK2_LIBC_PATH)/AppPkg/Applications/Python/Python-3.12.13/PyMod-3.12.13/Modules/openssl
  DEFINE LIBFFI_INT_INC       = $(EDK2_LIBC_PATH)/AppPkg/Applications/Python/Python-3.12.13/PyMod-3.12.13/Modules/libffi/libffi/include
  # MSVC _ctypes uses libffi_msvc (Python368 pattern), not vendored edk2-libffi headers
  DEFINE LIBFFI_MSVC_INC      = $(EDK2_LIBC_PATH)/AppPkg/Applications/Python/Python-3.12.13/Modules/_ctypes/libffi_msvc
  DEFINE LIBFFI_MSVC_PYMOD_INC = $(EDK2_LIBC_PATH)/AppPkg/Applications/Python/Python-3.12.13/PyMod-3.12.13/Modules/_ctypes/libffi_msvc
  # Monolithic FULL module (Phase 8). MIN build uses Python312_MIN.inf

[Packages]
  MdePkg/MdePkg.dec
  MdeModulePkg/MdeModulePkg.dec
  ShellPkg/ShellPkg.dec
  StdLib/StdLib.dec
  AppPkg/AppPkg.dec

[LibraryClasses]
