[Defines]
  INF_VERSION                 = 0x00010016
  BASE_NAME                   = Python312
  FILE_GUID                   = 1c13d89b-76e2-4dd1-8acd-d542b8009c4f
  MODULE_TYPE                 = UEFI_APPLICATION
  VERSION_STRING              = 0.1
  ENTRY_POINT                 = UefiMain

  DEFINE PYTHON_VERSION       = 3.12.13
  DEFINE LIBFFI_INC           = $(EDK2_LIBC_PATH)/AppPkg/Applications/Python/Python-3.12.13/PyMod-3.12.13/Modules/libffi/include
  DEFINE LIBFFI_INT_INC       = $(EDK2_LIBC_PATH)/AppPkg/Applications/Python/Python-3.12.13/PyMod-3.12.13/Modules/libffi/libffi/include

[Packages]
